---
import BaseLayout from "~/components/layout/BaseLayout.astro";
---

<BaseLayout
  title="Download — Get Lucky Golf seed raise deck"
  description="Your download is ready. Grab the original 15-slide Get Lucky Golf investment deck (PDF) below."
  noindex
>
  <section class="container-page py-24 md:py-32 text-center">
    <p class="eyebrow eyebrow-red mb-4">Download ready</p>
    <h1 class="display-mega max-w-[16ch] mx-auto">
      Here's the deck.<br/>
      <span class="display-italic display-red">Annotations on the way.</span>
    </h1>
    <p class="lead mt-10 mx-auto">
      The PDF below is the 15-slide Get Lucky Golf deck I just used to close our R4M seed — exactly as it was sent. Annotations are at <a href="/the-get-lucky-deck" class="underline-slide text-[var(--color-red)]">/the-get-lucky-deck</a>.
    </p>

    <div class="mt-12 flex flex-wrap justify-center gap-3">
      <a href="/the-get-lucky-deck-2025.pdf" class="btn btn-primary" download>
        Download the PDF (2.3 MB) ↓
      </a>
      <a href="/the-get-lucky-deck" class="btn btn-ghost">Re-read the annotations</a>
    </div>

    <div class="mt-20 max-w-[42rem] mx-auto text-left card !p-7">
      <p class="eyebrow eyebrow-red mb-3">If you found this useful</p>
      <h2 class="font-display text-[1.35rem] font-semibold leading-tight mb-3">
        Want the same review on your own deck?
      </h2>
      <p class="text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
        The <a class="underline-slide text-[var(--color-red)]" href="/coaching#pitch-deck-sprint">Pitch Deck Sprint</a> is exactly this: three sessions, slide by slide, narrative rebuilt, deck ready to defend in any room.
      </p>
      <div class="mt-5">
        <a href="/coaching#pitch-deck-sprint" class="btn btn-primary">Start the Sprint →</a>
      </div>
    </div>
  </section>
</BaseLayout>
