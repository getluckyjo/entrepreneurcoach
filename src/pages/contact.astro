---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import { offers, site } from "~/data/site";
import { breadcrumbSchema } from "~/lib/seo";

/*
 * Contact page. Replaces the previous /book scheduler.
 * Visitor sends a message + suggests two times that work for them;
 * Johannes replies within one business day with a confirmed slot.
 *
 * Form delivery: formsubmit.co forwards every submission to site.email.
 * No account, no env vars. The first submission triggers a one-time
 * verification email to confirm the destination address.
 */

const formAction = `https://formsubmit.co/${site.email}`;
---

<BaseLayout
  title="Contact — Suggest two times to meet"
  description="Get in touch with Johannes le Roux. Tell me about the venture and suggest two times that work for you. One business day reply. Cape Town & remote."
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.domain },
      { name: "Contact", url: `${site.domain}/contact` },
    ]),
  ]}
>
  <section class="container-page pt-20 md:pt-24 pb-12">
    <p class="eyebrow eyebrow-red mb-6 reveal">Contact</p>
    <h1 class="display-mega max-w-[16ch] reveal">
      Tell me more<br/>
      <span class="display-italic display-red">about your venture.</span>
    </h1>
    <p class="lead mt-10 reveal">
      The 30-min Founder Clinic is free; packages start at R15,000. Send a short note and two times that suit you — I'll confirm within one business day.
    </p>
  </section>

  <section class="container-page pb-24 grid gap-8 md:grid-cols-12">
    <!-- Form -->
    <form
      class="md:col-span-7 card !p-7 space-y-5 reveal"
      method="post"
      action={formAction}
      novalidate
    >
      <p class="font-display text-[1.05rem] font-semibold">Send a message</p>

      <div class="grid gap-5 md:grid-cols-2">
        <label class="block text-[13px] font-display font-semibold">
          Name
          <input
            name="name" required type="text" autocomplete="name"
            class="mt-1.5 w-full px-3 py-2.5 border border-[var(--color-rule-strong)] rounded-[var(--radius-sm)] bg-[var(--color-paper)] focus:border-[var(--color-red)] focus:outline-none font-sans font-normal text-[15px]"
          />
        </label>

        <label class="block text-[13px] font-display font-semibold">
          Email
          <input
            name="email" required type="email" autocomplete="email"
            class="mt-1.5 w-full px-3 py-2.5 border border-[var(--color-rule-strong)] rounded-[var(--radius-sm)] bg-[var(--color-paper)] focus:border-[var(--color-red)] focus:outline-none font-sans font-normal text-[15px]"
          />
        </label>
      </div>

      <label class="block text-[13px] font-display font-semibold">
        Stage of the venture
        <select
          name="stage" required
          class="mt-1.5 w-full px-3 py-2.5 border border-[var(--color-rule-strong)] rounded-[var(--radius-sm)] bg-[var(--color-paper)] focus:border-[var(--color-red)] focus:outline-none font-sans font-normal text-[15px]"
        >
          <option value="">Select…</option>
          <option value="idea">Pre-launch / idea</option>
          <option value="launching">Launching (0–12 months)</option>
          <option value="managing">Operating (1–3 years, &lt; 30 staff)</option>
          <option value="scaling">Scaling (PMF, going international)</option>
        </select>
      </label>

      <label class="block text-[13px] font-display font-semibold">
        Package
        <select
          name="offer"
          class="mt-1.5 w-full px-3 py-2.5 border border-[var(--color-rule-strong)] rounded-[var(--radius-sm)] bg-[var(--color-paper)] focus:border-[var(--color-red)] focus:outline-none font-sans font-normal text-[15px]"
        >
          <option value="">No preference yet</option>
          {offers.map((o) => (
            <option value={o.slug}>{o.name} ({o.price})</option>
          ))}
        </select>
      </label>

      <fieldset class="border-t border-[var(--color-rule)] pt-5">
        <legend class="text-[13px] font-display font-semibold mb-1">Suggest two times to meet</legend>
        <p class="text-[12px] text-[var(--color-muted)] mb-4">
          Pick two windows that suit you (your local time is fine). I'll confirm one of them — or propose alternatives if neither works.
        </p>

        <div class="grid gap-5 md:grid-cols-2">
          <label class="block text-[13px] font-display font-semibold">
            Option 1
            <input
              name="time-option-1" required type="datetime-local"
              class="mt-1.5 w-full px-3 py-2.5 border border-[var(--color-rule-strong)] rounded-[var(--radius-sm)] bg-[var(--color-paper)] focus:border-[var(--color-red)] focus:outline-none font-sans font-normal text-[15px]"
            />
          </label>

          <label class="block text-[13px] font-display font-semibold">
            Option 2
            <input
              name="time-option-2" required type="datetime-local"
              class="mt-1.5 w-full px-3 py-2.5 border border-[var(--color-rule-strong)] rounded-[var(--radius-sm)] bg-[var(--color-paper)] focus:border-[var(--color-red)] focus:outline-none font-sans font-normal text-[15px]"
            />
          </label>
        </div>

        <label class="block text-[13px] font-display font-semibold mt-5">
          Time zone
          <input
            name="timezone" type="text" placeholder="e.g. SAST (Cape Town), GMT (London), ET (New York)"
            class="mt-1.5 w-full px-3 py-2.5 border border-[var(--color-rule-strong)] rounded-[var(--radius-sm)] bg-[var(--color-paper)] focus:border-[var(--color-red)] focus:outline-none font-sans font-normal text-[15px]"
          />
        </label>
      </fieldset>

      <label class="block text-[13px] font-display font-semibold">
        Tell me about the venture
        <textarea
          name="message" rows="5" required
          placeholder="What you're building, what's stuck, what you'd want from the call."
          class="mt-1.5 w-full px-3 py-2.5 border border-[var(--color-rule-strong)] rounded-[var(--radius-sm)] bg-[var(--color-paper)] focus:border-[var(--color-red)] focus:outline-none font-sans font-normal text-[15px]"
        ></textarea>
      </label>

      <input type="hidden" name="_subject" value="New enquiry from entrepreneurcoach.co.za" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value={`${site.domain}/thanks`} />
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <p class="text-[12px] text-[var(--color-muted)] leading-relaxed">
        Submitting this form means you agree to my <a class="underline-slide text-[var(--color-red)]" href="/privacy">privacy policy</a>. Your information is used only to reply to your enquiry.
      </p>

      <button type="submit" class="btn btn-primary w-full">Send →</button>
    </form>

    <!-- Sidebar -->
    <aside class="md:col-span-5 reveal space-y-6">
      <div class="card">
        <p class="eyebrow eyebrow-red mb-4">What happens next</p>
        <ol class="space-y-4 text-[14.5px] leading-relaxed text-[var(--color-ink-soft)]">
          <li class="flex gap-3">
            <span class="num-badge !text-[1rem] !text-[var(--color-ink)] flex-shrink-0">01</span>
            <span>I read every enquiry myself, usually same day.</span>
          </li>
          <li class="flex gap-3">
            <span class="num-badge !text-[1rem] !text-[var(--color-ink)] flex-shrink-0">02</span>
            <span>You'll get a calendar invite confirming one of your suggested times — or two alternatives if neither works.</span>
          </li>
          <li class="flex gap-3">
            <span class="num-badge !text-[1rem] !text-[var(--color-ink)] flex-shrink-0">03</span>
            <span>A short pre-work brief lands with the invite so we can start at speed.</span>
          </li>
        </ol>
      </div>

      <div class="card">
        <p class="eyebrow eyebrow-red mb-4">Other ways to reach me</p>
        <ul class="space-y-3 text-[14.5px]">
          <li>
            <span class="block text-[12px] uppercase tracking-[0.12em] text-[var(--color-muted)]">Email</span>
            <a href={`mailto:${site.email}`} class="underline-slide text-[var(--color-red)] font-semibold">{site.email}</a>
          </li>
          <li>
            <span class="block text-[12px] uppercase tracking-[0.12em] text-[var(--color-muted)]">In person</span>
            <span>{site.address.street}<br/>{site.address.city}, {site.address.region} {site.address.postalCode}</span>
          </li>
          <li>
            <span class="block text-[12px] uppercase tracking-[0.12em] text-[var(--color-muted)]">Hours</span>
            <span>{site.hours}</span>
          </li>
        </ul>
      </div>
    </aside>
  </section>

  <script>
    // Pre-select the package dropdown when arriving with ?offer=<slug>.
    // Done client-side so it works with the static prerender.
    const apply = () => {
      const slug = new URLSearchParams(window.location.search).get("offer");
      if (!slug) return;
      const select = document.querySelector<HTMLSelectElement>('select[name="offer"]');
      if (select && [...select.options].some((o) => o.value === slug)) {
        select.value = slug;
      }
    };
    apply();
    document.addEventListener("astro:after-swap", apply);
  </script>
</BaseLayout>
