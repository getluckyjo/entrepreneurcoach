---
import BaseLayout from "~/components/layout/BaseLayout.astro";
---

<BaseLayout title="Thanks — message received" noindex>
  <section class="container-page py-24 md:py-32 text-center">
    <p class="eyebrow eyebrow-red mb-4">Received</p>
    <h1 class="display-mega max-w-[14ch] mx-auto">
      Got it.<br/>
      <span class="display-italic display-red">Speak soon.</span>
    </h1>
    <p class="lead mt-10 mx-auto">
      I read every enquiry myself. You'll hear back within one business day.
    </p>
    <div class="mt-12 flex justify-center gap-3">
      <a href="/journal" class="btn btn-primary">Read the journal</a>
      <a href="/" class="btn btn-ghost">Back to home</a>
    </div>
  </section>
</BaseLayout>
