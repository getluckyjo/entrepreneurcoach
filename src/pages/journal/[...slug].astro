---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import BigCTA from "~/components/home/BigCTA.astro";
import { getCollection, render } from "astro:content";
import { articleSchema, breadcrumbSchema } from "~/lib/seo";
import { site, workshop, cohorts } from "~/data/site";

export async function getStaticPaths() {
  const posts = await getCollection("journal", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = `${site.domain}/journal/${post.slug}`;
const formatted = post.data.pubDate.toLocaleDateString("en-ZA", {
  year: "numeric", month: "long", day: "numeric",
});

const categoryClass = (c: string) =>
  c === "Playbook"    ? "pill-red" :
  c === "Field Notes" ? "pill-blue" :
  c === "Lecture"     ? "pill-ink" :
                        "pill-ghost";

/*
 * Closing CTAs. A post that argues for the workshop shouldn't end by selling
 * coaching, so `cta: "workshop"` in the frontmatter swaps both the footer
 * button and the full-bleed band. Copy lives here rather than in frontmatter
 * so it stays in one place across however many workshop posts get written.
 */
const bookLabel = cohorts.length > 0 ? "Book a seat" : "Join the waitlist";

const CTAS = {
  clinic: {
    footerLabel: "Book a Founder Clinic",
    footerHref: "/contact",
    band: undefined, // BigCTA's own defaults are the clinic close
  },
  workshop: {
    footerLabel: bookLabel,
    footerHref: "/workshop#signup",
    band: {
      eyebrow: `${workshop.duration} · ${workshop.seats} seats · ${workshop.venue.area}`,
      title: ["Eight seats.", "That's it."],
      body: "Everyone brings one real job from their own business, and we get it running before you leave. At twenty people that's a lecture. At eight it stays a workshop — which is the whole point, and the reason it isn't cheap.",
      ctaLabel: bookLabel,
      ctaHref: "/workshop#signup",
    },
  },
  // No `as const` — it would make `title` a readonly tuple, and BigCTA's Props
  // declares a mutable string[].
};

const cta = CTAS[post.data.cta];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  jsonLd={[
    articleSchema({
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate,
      updatedDate: post.data.updatedDate,
      category: post.data.category,
      url,
    }),
    breadcrumbSchema([
      { name: "Home",     url: site.domain },
      { name: "Journal",  url: `${site.domain}/journal` },
      { name: post.data.title, url },
    ]),
  ]}
>
  <article class="pt-20 md:pt-24 pb-20">
    <header class="container-prose">
      <div class="flex items-center gap-3 mb-8 reveal">
        <span class:list={["pill", categoryClass(post.data.category)]}>{post.data.category}</span>
        <span class="text-[12px] text-[var(--color-muted)] uppercase tracking-[0.1em]">{formatted}</span>
      </div>
      <h1 class="display-l !text-[clamp(2.4rem,5vw,4rem)] reveal">{post.data.title}</h1>
      <p class="lead mt-8 reveal">{post.data.description}</p>
    </header>

    <div class="container-prose mt-14 prose reveal">
      <Content />
    </div>

    <footer class="container-prose mt-20 pt-10 border-t border-[var(--color-rule)] flex flex-wrap gap-4 justify-between items-center">
      <a href="/journal" class="btn-link text-[13px]">← All posts</a>
      <a href={cta.footerHref} class="btn btn-primary">{cta.footerLabel}</a>
    </footer>
  </article>

  <BigCTA {...(cta.band ?? {})} />
</BaseLayout>
