---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import BigCTA from "~/components/home/BigCTA.astro";
import { getCollection, render } from "astro:content";
import { articleSchema, breadcrumbSchema } from "~/lib/seo";
import { site } from "~/data/site";

export async function getStaticPaths() {
  const posts = await getCollection("journal", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = `${site.domain}/journal/${post.slug}`;
const formatted = post.data.pubDate.toLocaleDateString("en-ZA", {
  year: "numeric", month: "long", day: "numeric",
});

const categoryClass = (c: string) =>
  c === "Playbook"    ? "pill-red" :
  c === "Field Notes" ? "pill-blue" :
  c === "Lecture"     ? "pill-ink" :
                        "pill-ghost";
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  jsonLd={[
    articleSchema({
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate,
      updatedDate: post.data.updatedDate,
      category: post.data.category,
      url,
    }),
    breadcrumbSchema([
      { name: "Home",     url: site.domain },
      { name: "Journal",  url: `${site.domain}/journal` },
      { name: post.data.title, url },
    ]),
  ]}
>
  <article class="pt-20 md:pt-24 pb-20">
    <header class="container-prose">
      <div class="flex items-center gap-3 mb-8 reveal">
        <span class:list={["pill", categoryClass(post.data.category)]}>{post.data.category}</span>
        <span class="text-[12px] text-[var(--color-muted)] uppercase tracking-[0.1em]">{formatted}</span>
      </div>
      <h1 class="display-l !text-[clamp(2.4rem,5vw,4rem)] reveal">{post.data.title}</h1>
      <p class="lead mt-8 reveal">{post.data.description}</p>
    </header>

    <div class="container-prose mt-14 prose reveal">
      <Content />
    </div>

    <footer class="container-prose mt-20 pt-10 border-t border-[var(--color-rule)] flex flex-wrap gap-4 justify-between items-center">
      <a href="/journal" class="btn-link text-[13px]">← All posts</a>
      <a href="/contact" class="btn btn-primary">Book a Founder Clinic</a>
    </footer>
  </article>

  <BigCTA />
</BaseLayout>
