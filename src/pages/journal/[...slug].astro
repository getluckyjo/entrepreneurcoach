---
import BaseLayout from "~/components/layout/BaseLayout.astro";
import BigCTA from "~/components/home/BigCTA.astro";
import { getCollection, render } from "astro:content";
import { articleSchema, breadcrumbSchema, videoSchema } from "~/lib/seo";
import DeckLinks from "~/components/ui/DeckLinks.astro";
import { site, workshop, cohorts } from "~/data/site";

export async function getStaticPaths() {
  const posts = await getCollection("journal", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Two related posts: same category first, then the most recent others.
const others = (await getCollection("journal", ({ data }) => !data.draft))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const related = [
  ...others.filter((p) => p.data.category === post.data.category),
  ...others.filter((p) => p.data.category !== post.data.category),
].slice(0, 2);
const metaDescription = post.data.seoDescription ?? post.data.description;
const url = `${site.domain}/journal/${post.slug}`;
const formatted = post.data.pubDate.toLocaleDateString("en-ZA", {
  year: "numeric", month: "long", day: "numeric",
});

const categoryClass = (c: string) =>
  c === "Playbook"    ? "pill-red" :
  c === "Field Notes" ? "pill-blue" :
  c === "Lecture"     ? "pill-ink" :
                        "pill-ghost";

/*
 * Closing CTA. `cta: "workshop"` in the frontmatter swaps the full-bleed band
 * so a post arguing for the workshop doesn't end by selling coaching.
 *
 * Only the band carries a CTA. The footer used to repeat it as a button
 * immediately above, which meant every post asked for the same thing twice
 * in the space of one screen.
 */
const bookLabel = cohorts.length > 0 ? "Book a seat" : "Join the waitlist";

const BANDS = {
  clinic: undefined, // BigCTA's own defaults are the clinic close
  workshop: {
    eyebrow: `${workshop.duration} · ${workshop.seats} seats · ${workshop.venue.area}`,
    title: ["Eight seats.", "That's it."],
    body: "Everyone brings one real job from their own business, and we get it running before you leave. At twenty people that's a lecture. At eight it stays a workshop — which is the whole point, and the reason it isn't cheap.",
    ctaLabel: bookLabel,
    ctaHref: "/workshop#signup",
  },
  // No `as const` — it would make `title` a readonly tuple, and BigCTA's Props
  // declares a mutable string[].
};

const band = BANDS[post.data.cta];
---

<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={metaDescription}
  article={{ published: post.data.pubDate, modified: post.data.updatedDate }}
  jsonLd={[
    articleSchema({
      title: post.data.title,
      description: metaDescription,
      pubDate: post.data.pubDate,
      updatedDate: post.data.updatedDate,
      category: post.data.category,
      url,
    }),
    breadcrumbSchema([
      { name: "Home",     url: site.domain },
      { name: "Journal",  url: `${site.domain}/journal` },
      { name: post.data.title, url },
    ]),
    ...(post.data.video
      ? [videoSchema({
          name: post.data.video.name,
          description: metaDescription,
          thumbnailUrl: post.data.video.thumbnail,
          uploadDate: post.data.video.uploadDate,
          embedUrl: `https://www.youtube.com/embed/${post.data.video.youtubeId}`,
          contentUrl: `https://www.youtube.com/watch?v=${post.data.video.youtubeId}`,
        })]
      : []),
  ]}
>
  <article class="pt-20 md:pt-24 pb-20">
    <header class="container-prose">
      <div class="flex items-center gap-3 mb-8">
        <span class:list={["pill", categoryClass(post.data.category)]}>{post.data.category}</span>
        <span class="text-[12px] text-[var(--color-muted)] uppercase tracking-[0.1em]">{formatted}</span>
      </div>
      <h1 class="display-l !text-[clamp(2.4rem,5vw,4rem)]">{post.data.title}</h1>
      <p class="lead mt-8">{post.data.description}</p>
    </header>

    <div class="container-prose mt-14 prose">
      <Content />
    </div>

    {post.data.decks && (
      <div class="container-page mt-20">
        <DeckLinks title="The annotated decks" />
      </div>
    )}

    <aside class="container-prose mt-20" aria-labelledby="related-title">
      <p id="related-title" class="eyebrow mb-6">Related</p>
      <ul class="grid gap-6 sm:grid-cols-2">
        {related.map((r) => (
          <li>
            <a href={`/journal/${r.slug}`} class="group block border-t border-[var(--color-rule)] pt-5">
              <span class="text-[12px] uppercase tracking-[0.1em] text-[var(--color-muted)]">{r.data.category}</span>
              <span class="block mt-2 text-[17px] font-semibold leading-snug group-hover:text-[var(--color-red)] transition-colors">{r.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <footer class="container-prose mt-20 pt-10 border-t border-[var(--color-rule)] flex flex-wrap gap-4 justify-between items-center">
      <a href="/journal" class="btn-link text-[13px]">← All posts</a>
    </footer>
  </article>

  <BigCTA {...(band ?? {})} />
</BaseLayout>
