---
import { site } from "~/data/site";
import BrandMark from "~/components/ui/BrandMark.astro";
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-night)] text-[var(--color-paper)] relative overflow-hidden">
  <!-- Massive faded "le Roux" signature watermark -->
  <p
    class="absolute inset-x-0 -bottom-8 md:-bottom-16 text-center pointer-events-none select-none whitespace-nowrap"
    style="font-family: var(--font-script); font-weight: 700; font-size: clamp(7rem, 22vw, 22rem); line-height: 0.85; color: rgb(255 255 255 / 0.06);"
    aria-hidden="true"
  >le Roux</p>

  <div class="container-page pt-24 pb-16 relative">
    <div class="grid gap-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="display-l">
          Got a venture you want a second pair of eyes on?
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Get in touch →</a>
          <a href="/coaching" class="btn btn-light">See coaching options</a>
        </div>
      </div>

      <div class="md:col-span-3 md:col-start-7">
        <p class="eyebrow !text-[var(--color-paper)]/60 mb-5">Site</p>
        <ul class="space-y-2 text-[15px]">
          <li><a class="hover:text-[var(--color-red)]" href="/coaching">Coaching</a></li>
          <li><a class="hover:text-[var(--color-red)]" href="/about">About</a></li>
          <li><a class="hover:text-[var(--color-red)]" href="/talks">Talks</a></li>
          <li><a class="hover:text-[var(--color-red)]" href="/journal">Journal</a></li>
          <li><a class="hover:text-[var(--color-red)]" href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="eyebrow !text-[var(--color-paper)]/60 mb-5">Contact</p>
        <address class="not-italic text-[15px] space-y-1 text-[var(--color-paper)]/85">
          <p><a href={`mailto:${site.email}`} class="hover:text-[var(--color-red)]">{site.email}</a></p>
          <p>{site.address.street}<br/>{site.address.city}, {site.address.region} {site.address.postalCode}</p>
          <p class="text-[var(--color-paper)]/55">{site.hours}</p>
        </address>
        <div class="mt-5 flex gap-5 text-[14px]">
          {site.social.linkedin && (
            <a href={site.social.linkedin} class="hover:text-[var(--color-red)]" rel="me">LinkedIn</a>
          )}
          {site.social.twitter && (
            <a href={site.social.twitter} class="hover:text-[var(--color-red)]" rel="me">X / Twitter</a>
          )}
        </div>
      </div>
    </div>

    <div class="mt-20 pt-8 border-t border-white/10 flex flex-col gap-3 md:flex-row md:items-center md:justify-between text-[13px] text-[var(--color-paper)]/55">
      <div class="flex items-center gap-4">
        <BrandMark size={20} invert />
        <p>© {year}. All rights reserved.</p>
      </div>
      <ul class="flex flex-wrap gap-5">
        <li><a class="hover:text-[var(--color-red)]" href="/privacy">Privacy</a></li>
        <li><a class="hover:text-[var(--color-red)]" href="/terms">Terms of engagement</a></li>
        <li><a class="hover:text-[var(--color-red)]" href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>
