---
/**
 * Click-to-load YouTube embed.
 *
 * The site's cookie banner promises no third-party tag fires until the visitor
 * accepts, so a plain <iframe> would break that promise on page load. This
 * renders a first-party poster instead — the thumbnail is served from
 * /public, not i.ytimg.com — and only reaches YouTube once the visitor
 * presses play. Faster too: an embedded player is ~1MB of JS nobody asked for.
 *
 * Poster convention: drop the still at /public/img/journal/<slug>.jpg (1280×720).
 * Grab it with: curl -o public/img/journal/<slug>.jpg \
 *   "https://i.ytimg.com/vi/<id>/maxresdefault.jpg"
 *
 * Usage inside an .mdx post:
 *   import VideoEmbed from "~/components/ui/VideoEmbed.astro";
 *   <VideoEmbed id="q2XjUTUS8Ts" title="…" poster="/img/journal/…jpg" caption="…" />
 */
interface Props {
  /** YouTube video ID — the v= parameter, not the full URL. */
  id: string;
  /** Accessible name for the player. Used on the play button and the iframe. */
  title: string;
  /** First-party poster path under /public. */
  poster: string;
  /** Optional line under the player — outlet, show, air date. */
  caption?: string;
  class?: string;
}
const { id, title, poster, caption, class: cls } = Astro.props;
---

<figure class:list={["my-10", cls]}>
  <div
    class="video-embed relative w-full aspect-video overflow-hidden rounded-[var(--radius-md)] bg-[var(--color-night)]"
    data-video-id={id}
    data-video-title={title}
  >
    <button
      type="button"
      class="group absolute inset-0 w-full h-full cursor-pointer"
      aria-label={`Play video: ${title}`}
    >
      <img
        src={poster}
        alt=""
        width="1280" height="720"
        class="w-full h-full object-cover transition-[transform,opacity] duration-500 ease-out
               group-hover:scale-[1.02] group-hover:opacity-90"
        loading="lazy" decoding="async"
      />
      <span
        class="absolute inset-0 flex items-center justify-center"
        style="background: linear-gradient(to top, rgb(10 10 12 / 0.45), rgb(10 10 12 / 0.05));"
      >
        <span
          class="flex items-center justify-center rounded-full transition-transform duration-300 ease-out
                 group-hover:scale-110 group-focus-visible:scale-110"
          style="width: 76px; height: 76px; background: var(--color-red);
                 box-shadow: 0 12px 40px -12px rgb(0 0 0 / 0.6);"
        >
          <svg width="26" height="30" viewBox="0 0 26 30" fill="none" aria-hidden="true"
               style="margin-left: 5px;">
            <path d="M25 13.27a2 2 0 0 1 0 3.46L3 29.4A2 2 0 0 1 0 27.66V2.34A2 2 0 0 1 3 .6l22 12.67Z"
                  fill="var(--color-paper)" />
          </svg>
        </span>
      </span>
    </button>
  </div>
  {caption && (
    <figcaption class="mt-3 text-[13px] leading-relaxed text-[var(--color-muted)]">
      {caption}
    </figcaption>
  )}
</figure>

<script>
  /* Swap the poster for the real player on click. Scoped per-instance so a post
     can carry more than one embed. Uses youtube-nocookie and only runs after an
     explicit press, so nothing reaches Google until the visitor asks for it. */
  document.querySelectorAll<HTMLElement>(".video-embed").forEach((wrap) => {
    const button = wrap.querySelector("button");
    if (!button) return;

    button.addEventListener("click", () => {
      const id = wrap.dataset.videoId;
      const title = wrap.dataset.videoTitle ?? "Video";
      if (!id) return;

      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      frame.title = title;
      frame.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      frame.allowFullscreen = true;
      frame.className = "absolute inset-0 w-full h-full border-0";

      wrap.replaceChildren(frame);
      frame.focus();
    });
  });
</script>
