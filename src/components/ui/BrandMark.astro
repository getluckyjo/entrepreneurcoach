---
/* Brand mark = the signature. "Johannes le Roux" handwritten in Caveat,
   with a vermilion dot punctuating the end (the historical "tick of approval" mark).
   No more square — the signature IS the brand. */
interface Props {
  size?: number;
  invert?: boolean;
  class?: string;
}
const { size = 28, invert = false, class: cls } = Astro.props;
const ink = invert ? "var(--color-paper)" : "var(--color-ink)";
const dotSize = Math.max(6, Math.round(size * 0.22));
---

<a
  href="/"
  class:list={["brand-mark inline-flex items-end gap-1.5 group leading-none", cls]}
  aria-label="Johannes le Roux — home"
>
  <span
    class="brand-mark-name"
    style={`font-size: ${size}px; color: ${ink};`}
  >
    Johannes le Roux
  </span>
  <span
    class="brand-mark-dot"
    style={`width: ${dotSize}px; height: ${dotSize}px;`}
    aria-hidden="true"
  ></span>
</a>

<style>
  .brand-mark-name {
    font-family: var(--font-script);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: 0.005em;
    display: inline-block;
    transform: rotate(-2deg);
    transform-origin: left bottom;
    transition: color 200ms ease, transform 200ms ease;
    white-space: nowrap;
  }
  .brand-mark:hover .brand-mark-name {
    color: var(--color-red);
    transform: rotate(-3deg);
  }
  .brand-mark-dot {
    display: inline-block;
    background: var(--color-red);
    border-radius: 999px;
    flex-shrink: 0;
    margin-bottom: 4px;
    transition: transform 200ms ease;
  }
  .brand-mark:hover .brand-mark-dot {
    transform: scale(1.3);
  }
</style>
