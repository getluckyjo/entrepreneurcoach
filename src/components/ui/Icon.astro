---
/* Inline stroke icons for the workshop page.
 *
 * Deliberately geometric and thin-stroked to match OfferIllustration.astro —
 * this brand is sharp, not rounded-friendly. All strokes use currentColor so
 * they work on paper, bone and night without variants.
 */
interface Props {
  name:
    | "layers" | "plug" | "file" | "repeat" | "clock" | "calendar"
    | "chart" | "target" | "gear" | "wrench"
    | "check" | "arrow" | "cross";
  size?: number;
  class?: string;
}
const { name, size = 22, class: cls } = Astro.props;
const stroke = { fill: "none", stroke: "currentColor", "stroke-width": "1.5", "stroke-linecap": "round", "stroke-linejoin": "round" } as const;
---

<svg
  viewBox="0 0 24 24" width={size} height={size}
  class:list={cls} aria-hidden="true" focusable="false"
>
  {name === "layers" && (
    <g {...stroke}>
      <path d="M12 3 21 7.5 12 12 3 7.5 12 3Z" />
      <path d="M3 12.5 12 17l9-4.5" />
      <path d="M3 17 12 21.5 21 17" />
    </g>
  )}

  {name === "plug" && (
    <g {...stroke}>
      <path d="M9 3v5M15 3v5" />
      <path d="M6 8h12v3a6 6 0 0 1-6 6 6 6 0 0 1-6-6V8Z" />
      <path d="M12 17v4" />
    </g>
  )}

  {name === "file" && (
    <g {...stroke}>
      <path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8l-5-5Z" />
      <path d="M14 3v5h5" />
      <path d="M8.5 13h7M8.5 16.5h4.5" />
    </g>
  )}

  {name === "repeat" && (
    <g {...stroke}>
      <path d="M4 9V7.5A2.5 2.5 0 0 1 6.5 5H20" />
      <path d="M17 2l3 3-3 3" />
      <path d="M20 15v1.5a2.5 2.5 0 0 1-2.5 2.5H4" />
      <path d="M7 22l-3-3 3-3" />
    </g>
  )}

  {name === "clock" && (
    <g {...stroke}>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 6.5V12l3.5 2.5" />
    </g>
  )}

  {name === "calendar" && (
    <g {...stroke}>
      <rect x="3.5" y="5" width="17" height="16" rx="1.5" />
      <path d="M3.5 10h17M8 3v4M16 3v4" />
      <path d="M9 15l2 2 4-4" />
    </g>
  )}

  {name === "chart" && (
    <g {...stroke}>
      <path d="M3.5 20.5h17" />
      <rect x="5" y="13" width="3.5" height="7.5" />
      <rect x="10.25" y="9" width="3.5" height="11.5" />
      <rect x="15.5" y="4.5" width="3.5" height="16" />
    </g>
  )}

  {name === "target" && (
    <g {...stroke}>
      <circle cx="12" cy="12" r="8.5" />
      <circle cx="12" cy="12" r="4.5" />
      <circle cx="12" cy="12" r="0.9" />
    </g>
  )}

  {name === "gear" && (
    <g {...stroke}>
      <circle cx="12" cy="12" r="3.2" />
      <path d="M12 2.5v3M12 18.5v3M21.5 12h-3M5.5 12h-3M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1M18.7 18.7l-2.1-2.1M7.4 7.4 5.3 5.3" />
    </g>
  )}

  {name === "wrench" && (
    <g {...stroke}>
      <path d="M15.5 3a5.5 5.5 0 0 0-5 7.7L3 18.2 5.8 21l7.5-7.5A5.5 5.5 0 0 0 20.5 8l-3 3-2.5-2.5 3-3A5.5 5.5 0 0 0 15.5 3Z" />
    </g>
  )}

  {name === "check" && (
    <path d="M3.5 12.5 9 18 20.5 6" {...stroke} stroke-width="2" />
  )}

  {name === "arrow" && (
    <g {...stroke}>
      <path d="M4 12h15M13.5 6.5 20 12l-6.5 5.5" />
    </g>
  )}

  {name === "cross" && (
    <path d="M6 6l12 12M18 6 6 18" {...stroke} />
  )}
</svg>
