---
/* One distinctive abstract SVG per offer slug.
   Strokes use currentColor so they pick up theme on dark/light cards. */
interface Props { slug: string; class?: string; }
const { slug, class: cls } = Astro.props;
---

{slug === "founder-clinic" && (
  <svg viewBox="0 0 200 120" class:list={cls} aria-hidden="true">
    <!-- Compass / bearings — quick orientation -->
    <circle cx="100" cy="60" r="44" fill="none" stroke="currentColor" stroke-width="1"/>
    <circle cx="100" cy="60" r="28" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 4"/>
    <line x1="100" y1="14" x2="100" y2="106" stroke="currentColor" stroke-width="1"/>
    <line x1="54"  y1="60" x2="146" y2="60" stroke="currentColor" stroke-width="1"/>
    <path d="M100 30 L106 60 L100 56 L94 60 Z" fill="var(--color-accent)"/>
    <text x="100" y="11" text-anchor="middle" font-size="6" letter-spacing="2" fill="currentColor" opacity="0.6">N</text>
  </svg>
)}

{slug === "pitch-deck-sprint" && (
  <svg viewBox="0 0 200 120" class:list={cls} aria-hidden="true">
    <!-- Stacked slides ascending — the rebuild from narrative up -->
    {[0, 1, 2, 3, 4].map((i) => (
      <rect
        x={20 + i * 22} y={80 - i * 12} width="80" height="34"
        fill={i === 4 ? "var(--color-accent)" : "none"}
        stroke="currentColor" stroke-width="1"
        rx="2"
      />
    ))}
    <line x1="138" y1="80" x2="180" y2="40" stroke="var(--color-accent)" stroke-width="1.5" stroke-dasharray="2 3"/>
    <circle cx="180" cy="40" r="3" fill="var(--color-accent)"/>
  </svg>
)}

{slug === "founder-os" && (
  <svg viewBox="0 0 200 120" class:list={cls} aria-hidden="true">
    <!-- Calendar grid with one cell highlighted = weekly cadence -->
    {Array.from({ length: 5 }, (_, r) => Array.from({ length: 7 }, (_, c) => {
      const isAccent = r === 2 && c === 3;
      return (
        <rect
          x={26 + c * 22} y={20 + r * 16} width="18" height="12"
          fill={isAccent ? "var(--color-accent)" : "none"}
          stroke="currentColor" stroke-width="1"
        />
      );
    })).flat()}
  </svg>
)}

{slug === "cashflow-projection" && (
  <svg viewBox="0 0 200 120" class:list={cls} aria-hidden="true">
    <!-- Baseline -->
    <line x1="20" y1="100" x2="180" y2="100" stroke="currentColor" stroke-width="1"/>
    <!-- 5 ascending bars (years 1–5) -->
    <rect x="30"  y="80" width="14" height="20" fill="none"               stroke="currentColor" stroke-width="1"/>
    <rect x="60"  y="65" width="14" height="35" fill="none"               stroke="currentColor" stroke-width="1"/>
    <rect x="90"  y="50" width="14" height="50" fill="none"               stroke="currentColor" stroke-width="1"/>
    <rect x="120" y="35" width="14" height="65" fill="none"               stroke="currentColor" stroke-width="1"/>
    <rect x="150" y="20" width="14" height="80" fill="var(--color-red)"   stroke="none"/>
    <!-- Year labels -->
    <text x="33"  y="115" font-size="6" fill="currentColor" opacity="0.6">Y1</text>
    <text x="63"  y="115" font-size="6" fill="currentColor" opacity="0.6">Y2</text>
    <text x="93"  y="115" font-size="6" fill="currentColor" opacity="0.6">Y3</text>
    <text x="123" y="115" font-size="6" fill="currentColor" opacity="0.6">Y4</text>
    <text x="153" y="115" font-size="6" fill="currentColor" opacity="0.6">Y5</text>
    <!-- Trend line connecting tops -->
    <path d="M37 80 L67 65 L97 50 L127 35 L157 20" fill="none" stroke="var(--color-red)" stroke-width="1.5" stroke-dasharray="2 2"/>
  </svg>
)}

{slug === "custom-hourly" && (
  <svg viewBox="0 0 200 120" class:list={cls} aria-hidden="true">
    <!-- Clock face — 60 minutes on demand -->
    <circle cx="100" cy="60" r="42" fill="none" stroke="currentColor" stroke-width="1.2"/>
    {Array.from({ length: 12 }, (_, i) => {
      const a = (i * 30 - 90) * Math.PI / 180;
      const x1 = 100 + Math.cos(a) * 36;
      const y1 = 60 + Math.sin(a) * 36;
      const x2 = 100 + Math.cos(a) * 42;
      const y2 = 60 + Math.sin(a) * 42;
      return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="currentColor" stroke-width={i % 3 === 0 ? 1.5 : 0.8}/>;
    })}
    <line x1="100" y1="60" x2="100" y2="32" stroke="var(--color-red)" stroke-width="2" stroke-linecap="round"/>
    <line x1="100" y1="60" x2="124" y2="60" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="100" cy="60" r="2.5" fill="var(--color-red)"/>
  </svg>
)}

{slug === "international-launch" && (
  <svg viewBox="0 0 200 120" class:list={cls} aria-hidden="true">
    <!-- Globe wireframe with a flight arc -->
    <circle cx="100" cy="60" r="40" fill="none" stroke="currentColor" stroke-width="1"/>
    <ellipse cx="100" cy="60" rx="40" ry="18" fill="none" stroke="currentColor" stroke-width="1" opacity="0.6"/>
    <ellipse cx="100" cy="60" rx="18" ry="40" fill="none" stroke="currentColor" stroke-width="1" opacity="0.6"/>
    <line x1="60" y1="60" x2="140" y2="60" stroke="currentColor" stroke-width="1" opacity="0.4"/>
    <path d="M70 75 Q100 20 130 50" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-dasharray="3 3"/>
    <circle cx="70" cy="75" r="3" fill="var(--color-accent)"/>
    <circle cx="130" cy="50" r="3" fill="var(--color-accent)"/>
  </svg>
)}
