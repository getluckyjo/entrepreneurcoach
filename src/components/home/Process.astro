---
import SectionHeader from "~/components/ui/SectionHeader.astro";

const steps = [
  {
    n: "01",
    title: "Discovery",
    body: "Free 30-min Founder Clinic. We figure out whether you need a co-founder, a sprint, or neither right now.",
  },
  {
    n: "02",
    title: "Scope",
    body: "Calendar invite + a short pre-work brief land within one business day. For the seat, the first session sets the hours tier, the money and the first 90 days. For the sprint, it sets the deliverable.",
  },
  {
    n: "03",
    title: "In the business",
    body: "One list, one weekly call, WhatsApp in between. In person in Cape Town or over Zoom. I take what's stuck that week and move it.",
  },
  {
    n: "04",
    title: "Results",
    body: "A deck that raised. A first customer abroad. A sponsor signed. A week that isn't yours alone to carry. Reviewed every 90 days.",
  },
] as const;
---

<section class="bg-[var(--color-bone)] border-y border-[var(--color-rule)]">
  <div class="container-page py-24 md:py-32">
    <SectionHeader
      eyebrow="How it runs"
      title="Four steps,"
      italic="start to deliverable."
      lede="Simple on purpose. You always know what's next and what it costs."
    />

    <ol class="mt-16 grid gap-px bg-[var(--color-rule)] md:grid-cols-2 lg:grid-cols-4 rounded-[var(--radius-lg)] overflow-hidden border border-[var(--color-rule)]">
      {steps.map((s, i) => (
        <li class="bg-[var(--color-paper)] p-7 md:p-8 flex flex-col reveal relative">
          <div class="flex items-baseline gap-3 mb-2">
            <span class="num-badge">{s.n}</span>
            {i < steps.length - 1 && (
              <svg class="hidden lg:block ml-auto -mr-3" width="40" height="14" viewBox="0 0 40 14" aria-hidden="true">
                <path d="M2 7H36 M30 2L36 7L30 12" stroke="var(--color-ink)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
          </div>
          <h3 class="display-l !text-[clamp(1.4rem,2vw,1.7rem)] mt-4">
            {s.title}
          </h3>
          <p class="mt-4 text-[14.5px] text-[var(--color-ink-soft)] leading-relaxed">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
