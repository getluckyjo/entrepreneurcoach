# Copy to .env.local for local dev. Public vars must be prefixed PUBLIC_.
#
# The /contact form posts to formsubmit.co and forwards to site.email.
# No env var is needed — the first submission triggers a one-time
# verification email at the destination address to enable the endpoint.

# Analytics — Plausible v2 is hardcoded in BaseLayout (account ID lives
# in the script URL itself) and gated to production builds. Set GA4 only
# if you want a parallel GA stream alongside Plausible.
PUBLIC_GA4_ID=

# Newsletter (placeholder — wire to ConvertKit/Mailchimp/Beehiiv when ready)
PUBLIC_NEWSLETTER_ENDPOINT=
